# Configuración del frontend RunCoach AI.
# Copia este archivo como .env. El .env real NUNCA debe versionarse.

# ── Backend ──────────────────────────────────────────────────────────────────
# Desde el Sprint 3 los cuatro grupos de endpoints viven en el mismo backend
# FastAPI de este repositorio, así que las cuatro variables apuntan al mismo
# origen. Se conservan separadas porque la aplicación nació sobre cuatro
# microservicios y podrían volver a separarse.
VITE_AUTH_URL=http://localhost:8000
VITE_SESSIONS_URL=http://localhost:8000
VITE_METRICS_URL=http://localhost:8000
VITE_AGENT_URL=http://localhost:8000

# Opcional. Si no se define, el orquestador se busca en VITE_AGENT_URL.
# VITE_ORCHESTRATOR_URL=http://localhost:8000

# ── Firebase ─────────────────────────────────────────────────────────────────
# Valores de la consola de Firebase del proyecto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
