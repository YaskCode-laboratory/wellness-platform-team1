# Configuración de la plataforma Wellness.
# Copia este archivo como .env y completa los valores de tu entorno.
# .env está en .gitignore y NUNCA debe versionarse.

# ── Google Cloud ─────────────────────────────────────────────────────────────
# Proyecto y región donde viven Vertex AI y Firestore.
GCP_PROJECT=runcoach-ai-496921
GCP_LOCATION=us-central1

# Credenciales de servicio. Se deja COMENTADA a proposito: si se copia este
# archivo como .env tal cual, la variable apuntaria a una ruta inexistente y
# los clientes de Google la preferirian por encima de las Application Default
# Credentials, fallando con un error de archivo no encontrado que no sugiere
# su causa.
#
# En desarrollo local basta con:
#     gcloud auth application-default login
#     gcloud auth application-default set-quota-project <proyecto>
# En un entorno gestionado (Cloud Run) tampoco hace falta: la identidad la
# aporta la plataforma.
#
# Descomentala solo si vas a usar una cuenta de servicio con un archivo real.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/service-account.json

# ── Modelos ──────────────────────────────────────────────────────────────────
# Modelo generativo usado por los agentes y por el clasificador de intención.
GEMINI_MODEL=gemini-2.5-flash

# Modelo de embeddings para la indexación y la recuperación del pipeline RAG.
# Cambiarlo invalida el índice existente: los vectores de ChromaDB se
# generaron con este modelo y no son comparables con los de otro.
EMBEDDING_MODEL=text-embedding-004